## Setup

import ceevyte:narrativa as Narrativa
from ceevyte:narrativa import new_dialog

from example:preset import option
from example:preset import choice_menu

def SimpleSpeaker(face="\uE000", name="None", color="gray", line="Example Line", font="ceevyte:narrativa/heads/default"):
    return {
                "translate": f"%1$s %2$s:  {line}",
                "with": [
                    {
                        "text": face,
                        "font": font
                    },
                    {
                        "text": f"[{name}]",
                        "color": color
                    }
                ]
            }

def _Alex(line="Example Line"):
    return SimpleSpeaker(face="1", name="Alex", color="yellow", line=line)

def _Steve(line="Example Line"):
    return SimpleSpeaker(face="7", name="Steve", color="aqua", line=line)

## Dialogues

function ceevyte:dialog/example:
    new_dialog(
        lines=[
            [
                _Alex('"You don\'t look like you\'re'),
                'from around here."'
            ],
            ''
        ],
        actions=[
            "",
            "function ceevyte:choice/example"
        ],
        autodub="ceevyte:dialog.example."
    )


function ceevyte:dialog/example/my_life:
    new_dialog(
        lines=[
            [
                _Steve('"I\'ve lived here all my life!"')
            ],
            '_'
        ],
        actions=[
            "",
            "function ceevyte:dialog/example/oh_really"
        ],
        autodub="ceevyte:dialog.example.my_life."
    )


function ceevyte:dialog/example/oh_really:
    new_dialog(
        lines=[
            [
                _Alex('"Oh really? Then you must'),
                'know Mr. Bowler."'
            ],
            ''
        ],
        actions=[
            "",
            "function ceevyte:choice/example/oh_really"
        ],
        autodub="ceevyte:dialog.example.oh_really."
    )


function ceevyte:dialog/example/i_came:
    new_dialog(
        lines=[
            [
                _Steve('"I came here from Newton."')
            ],
            [
                _Alex('"Newton, eh? I heard there\'s'),
                'trouble brewing down there."'
            ],
            ''
        ],
        actions=[
            "",
            "",
            "function ceevyte:choice/example/i_came"
        ],
        autodub="ceevyte:dialog.example.i_came."
    )


function ceevyte:dialog/example/i_came/haven_t_heard:
    new_dialog(
        lines=[
            [
                _Steve('"I haven\'t heard about any trouble."')
            ],
            '_'
        ],
        actions=[
            "",
            "function ceevyte:dialog/example/don_t_worry"
        ],
        autodub="ceevyte:dialog.example.i_came.haven_t_heard."
    )


function ceevyte:dialog/example/i_came/actually_from:
    new_dialog(
        lines=[
            [
                _Steve('"Did I say Newton? I\'m actually from Springville."')
            ],
            '_'
        ],
        actions=[
            "",
            "function ceevyte:dialog/example/oh_really"
        ],
        autodub="ceevyte:dialog.example.i_came.actually_from."
    )


function ceevyte:dialog/example/my_life/good_friend:
    new_dialog(
        lines=[
            [
                _Steve('"Mr. Bowler is a good friend of mine!"')
            ],
            [
                _Alex('"You liar! There ain\'t no'),
                'Mr. Bowler, I made him up!"'
            ]
        ],
        autodub="ceevyte:dialog.example.my_life.good_friend."
    )


function ceevyte:dialog/example/my_life/who_:
    new_dialog(
        lines=[
            [
                _Steve('"Who?"')
            ],
            '_'
        ],
        actions=[
            "",
            "function ceevyte:dialog/example/don_t_worry"
        ],
        autodub="ceevyte:dialog.example.my_life.who_."
    )


function ceevyte:dialog/example/don_t_worry:
    new_dialog(
        lines=[
            [
                _Alex('"Don\'t you worry about it. Say,'),
                'do you have something to eat?',
                'I\'m starving."'
            ]
        ],
        autodub="ceevyte:dialog.example.don_t_worry."
    )


## Choices

function ceevyte:choice/example:
    choice_menu(
        options = [
            option(
                "I've lived here all my life!",
                "function ceevyte:dialog/example/my_life"
            ),

            option(
                "I came here from Newton.",
                "function ceevyte:dialog/example/i_came"
            )
        ]
    )

function ceevyte:choice/example/oh_really:
    choice_menu(
        options = [
            option(
                "Mr. Bowler is a good friend of mine!",
                "function ceevyte:dialog/example/my_life/good_friend"
            ),

            option(
                "Who?",
                "function ceevyte:dialog/example/my_life/who_"
            )
        ]
    )

function ceevyte:choice/example/i_came:
    choice_menu(
        options = [
            option(
                "I havent heard about any trouble.",
                "function ceevyte:dialog/example/i_came/haven_t_heard"
            ),

            option(
                "Did I say Newton? Im actually from Springville.",
                "function ceevyte:dialog/example/i_came/actually_from"
            )
        ]
    )