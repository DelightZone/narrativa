## Setup

from dataclasses import dataclass

import ceevyte:narrativa as Narrativa
from ceevyte:narrativa import new_dialog

# Enable if you need to quickly get 'sounds.json' without being bothered about it too much.
# Narrativa.DUMP_AUTODUB = True

choice = Narrativa.new_choice("username.example.narrativa.choice.index.e")

@dataclass
class Choice:
    name: str
    command: str

def option(choice_data):
    return {
        "text": f"\n{len(choice._get())}. {choice_data.name}",
        "click_event": {
            "action": "run_command",
            "command": choice.option(choice_data.command)
        }
    }

def choice_menu(
    title=  "Placeholder:",
    options=None
):
    components = [
        "",
        {
            "text": f"\n\n\n\n\n\n\n\n\n\n{title}",
            "color": "gray"
        }
    ]

    for data in options:
        components.append(option(data))

    scoreboard players enable @a username.example.narrativa.choice.index.e

    tellraw @a components

    choice.flush()


## Quotes

# You don't look like you're from around here.

# Oh really? Then you must know Mr. Bowler.

# You liar! There ain't no Mr. Bowler, I made him up!

# Don't you worry about it. Say, do you have something to eat? I'm starving.

# Newton, eh? I heard there's trouble brewing down there.


## Dialogues

function username:dialog/example/dialog_tree_example:
    new_dialog(
        lines=[
            [
                'Alex: "You don\'t look like you\'re',
                'from around here."'
            ],
            ''
        ],
        actions=[
            "",
            "function username:choice/example/dialog_tree_example"
        ],
        autodub="username:dialog.example.dialog_tree_example."
    )


