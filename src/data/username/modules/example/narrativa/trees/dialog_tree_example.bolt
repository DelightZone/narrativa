## Setup

import ceevyte:narrativa as Narrativa
from ceevyte:narrativa import new_dialog

from username:example/narrativa/tree import Choice
from username:example/narrativa/tree import choice
from username:example/narrativa/tree import choice_menu


## Dialogues

function username:dialog/example/dialog_tree_example:
    new_dialog(
        lines=[
            [
                'Alex: "You don\'t look like you\'re',
                'from around here."'
            ],
            ''
        ],
        actions=[
            "",
            "function username:choice/example/dialog_tree_example"
        ],
        autodub="username:dialog.example.dialog_tree_example."
    )


function username:dialog/example/dialog_tree_example/my_life:
    new_dialog(
        lines=[
            [
                'Steve: "I\'ve lived here all my life!"'
            ],
            '_'
        ],
        actions=[
            "",
            "function username:dialog/example/dialog_tree_example/oh_really"
        ],
        autodub="username:dialog.example.dialog_tree_example.my_life."
    )


function username:dialog/example/dialog_tree_example/oh_really:
    new_dialog(
        lines=[
            [
                'Alex: "Oh really? Then you must',
                'know Mr. Bowler."'
            ],
            ''
        ],
        actions=[
            "",
            "function username:choice/example/dialog_tree_example/oh_really"
        ],
        autodub="username:dialog.example.dialog_tree_example.oh_really."
    )


function username:dialog/example/dialog_tree_example/i_came:
    new_dialog(
        lines=[
            [
                'Steve: "I came here from Newton."'
            ],
            [
                'Alex: "Newton, eh? I heard there\'s',
                'trouble brewing down there."'
            ],
            ''
        ],
        actions=[
            "",
            "",
            "function username:choice/example/dialog_tree_example/i_came"
        ],
        autodub="username:dialog.example.dialog_tree_example.i_came."
    )


function username:dialog/example/dialog_tree_example/i_came/haven_t_heard:
    new_dialog(
        lines=[
            [
                'Steve: "I haven\'t heard about any trouble."'
            ],
            '_'
        ],
        actions=[
            "",
            "function username:dialog/example/dialog_tree_example/don_t_worry"
        ],
        autodub="username:dialog.example.dialog_tree_example.i_came.haven_t_heard."
    )


function username:dialog/example/dialog_tree_example/i_came/actually_from:
    new_dialog(
        lines=[
            [
                'Steve: "Did I say Newton? I\'m actually from Springville."'
            ],
            '_'
        ],
        actions=[
            "",
            "function username:dialog/example/dialog_tree_example/oh_really"
        ],
        autodub="username:dialog.example.dialog_tree_example.i_came.actually_from."
    )


function username:dialog/example/dialog_tree_example/my_life/good_friend:
    new_dialog(
        lines=[
            [
                'Steve: "Mr. Bowler is a good friend of mine!"'
            ],
            [
                'Alex: "You liar! There ain\'t no',
                'Mr. Bowler, I made him up!"'
            ]
        ],
        autodub="username:dialog.example.dialog_tree_example.my_life.good_friend."
    )


function username:dialog/example/dialog_tree_example/my_life/who_:
    new_dialog(
        lines=[
            [
                'Steve: "Who?"'
            ],
            '_'
        ],
        actions=[
            "",
            "function username:dialog/example/dialog_tree_example/don_t_worry"
        ],
        autodub="username:dialog.example.dialog_tree_example.my_life.who_."
    )


function username:dialog/example/dialog_tree_example/don_t_worry:
    new_dialog(
        lines=[
            [
                'Alex: "Don\'t you worry about it. Say,',
                'do you have something to eat?',
                'I\'m starving."'
            ]
        ],
        autodub="username:dialog.example.dialog_tree_example.don_t_worry."
    )


## Choices

function username:choice/example/dialog_tree_example:
    choice_menu(
        options = [
            Choice(
                "I've lived here all my life!",
                "function username:dialog/example/dialog_tree_example/my_life"
            ),

            Choice(
                "I came here from Newton.",
                "function username:dialog/example/dialog_tree_example/i_came"
            )
        ]
    )

function username:choice/example/dialog_tree_example/oh_really:
    choice_menu(
        options = [
            Choice(
                "Mr. Bowler is a good friend of mine!",
                "function username:dialog/example/dialog_tree_example/my_life/good_friend"
            ),

            Choice(
                "Who?",
                "function username:dialog/example/dialog_tree_example/my_life/who_"
            )
        ]
    )

function username:choice/example/dialog_tree_example/i_came:
    choice_menu(
        options = [
            Choice(
                "I havent heard about any trouble.",
                "function username:dialog/example/dialog_tree_example/i_came/haven_t_heard"
            ),

            Choice(
                "Did I say Newton? Im actually from Springville.",
                "function username:dialog/example/dialog_tree_example/i_came/actually_from"
            )
        ]
    )