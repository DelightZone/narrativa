import ceevyte:narrativa as Narrativa


## Tags

append function_tag minecraft:load {
    "values": [
        "username:example/narrativa/load"
    ]
}

append function_tag ceevyte:narrativa/show {
    "values": [
        "username:example/narrativa/show"
    ]
}

append function_tag ceevyte:narrativa/start {
    "values": [
        "username:example/narrativa/start"
    ]
}

append function_tag ceevyte:narrativa/end {
    "values": [
        "username:example/narrativa/end"
    ]
}


## Predicates

predicate username:example/narrativa/sneak {
    "condition": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "type_specific": {
            "type": "minecraft:player",
            "input": {
                "sneak": true
            }
        }
    }
}

predicate username:example/narrativa/sprint {
    "condition": "minecraft:entity_properties",
    "entity": "this",
    "predicate": {
        "type_specific": {
            "type": "minecraft:player",
            "input": {
                "forward": false,
                "backward": false,
                "left": false,
                "right": false,
                "sprint": true
            }
        }
    }
}


## General

function username:example/narrativa/load:
    scoreboard objectives add username.example.narrativa.sneak.e dummy {"text": "Sneak Toggle", "color": "gold"}
    scoreboard objectives add username.example.narrativa.sprint.e dummy {"text": "Sprint Toggle", "color": "gold"}

    bossbar add username:example/narrativa/header "Header"
    bossbar add username:example/narrativa/line1 "Line 1"
    bossbar add username:example/narrativa/line2 "Line 2"
    bossbar add username:example/narrativa/line3 "Line 3"

    function username:example/narrativa/tick

function username:example/narrativa/tick:
    schedule function username:example/narrativa/tick 1t replace
    execute as @a[tag=!username.example.narrativa.forbidden] at @s:
        ## Dialog

        execute unless predicate username:example/narrativa/sprint:
            execute if score @s username.example.narrativa.sprint.e matches 0:
                function ceevyte:narrativa/dialog/advance
            scoreboard players reset @s username.example.narrativa.sprint.e

        execute unless predicate username:example/narrativa/sneak if score @s username.example.narrativa.sneak.e matches 0:
            scoreboard players reset @s username.example.narrativa.sneak.e

            # Prevents the dialogue from ending on rewind.
            execute if score /dialog/index ceevyte.narrativa.g matches 1 run return 1
            function ceevyte:narrativa/dialog/rewind

        execute if predicate username:example/narrativa/sprint:
            execute unless score @s username.example.narrativa.sprint.e matches -1..0 run scoreboard players set @s username.example.narrativa.sprint.e 0
            execute if predicate username:example/narrativa/sneak:
                scoreboard players set @s username.example.narrativa.sneak.e 0
                scoreboard players set @s username.example.narrativa.sprint.e -1
        

        ## Choice

        execute unless score @s ceevyte.narrativa.option.e matches ..-1:
            execute if score @s ceevyte.narrativa.option.e matches 0..:
                tellraw @a [{"selector": "@s"}," ",{"text": "chose: "},{"score": {"name": "@s", "objective":"ceevyte.narrativa.option.e"}}]
            scoreboard players reset @s ceevyte.narrativa.option.e
        
function username:example/narrativa/choice/enable:
    scoreboard players enable @s ceevyte.narrativa.option.e
    scoreboard players set @s ceevyte.narrativa.option.e -1

function username:example/narrativa/start:
    bossbar set username:example/narrativa/header players @a
    bossbar set username:example/narrativa/line1 players @a
    bossbar set username:example/narrativa/line2 players @a
    bossbar set username:example/narrativa/line3 players @a

function username:example/narrativa/end:
    bossbar set username:example/narrativa/header players 0
    bossbar set username:example/narrativa/line1 players 0
    bossbar set username:example/narrativa/line2 players 0
    bossbar set username:example/narrativa/line3 players 0


## Display

function username:example/narrativa/show:
    bossbar set username:example/narrativa/line1 name {"nbt": "lines[0][0]", "storage": "ceevyte:narrativa","interpret":true}
    bossbar set username:example/narrativa/line2 name {"nbt": "lines[0][1]", "storage": "ceevyte:narrativa","interpret":true}
    bossbar set username:example/narrativa/line3 name {"nbt": "lines[0][2]", "storage": "ceevyte:narrativa","interpret":true}

    execute:
        data modify storage ceevyte:narrativa foo set from storage ceevyte:narrativa lines[0][2]
        execute if data storage ceevyte:narrativa foo unless data storage ceevyte:narrativa {foo: ""} run return:
            data modify storage ceevyte:narrativa bar set value "\uE002"

        data modify storage ceevyte:narrativa foo set from storage ceevyte:narrativa lines[0][1]
        execute if data storage ceevyte:narrativa foo unless data storage ceevyte:narrativa {foo: ""} run return:
            data modify storage ceevyte:narrativa bar set value "\uE001"

        data modify storage ceevyte:narrativa foo set from storage ceevyte:narrativa lines[0][0]
        execute if data storage ceevyte:narrativa foo unless data storage ceevyte:narrativa {foo: ""}:
            data modify storage ceevyte:narrativa bar set value "\uE000"

    bossbar set username:example/narrativa/header name {"nbt": "bar", "storage": "ceevyte:narrativa", "font":"username:example/narrativa/header", "shadow_color":0}
    data remove storage ceevyte:narrativa bar

    data modify storage ceevyte:narrativa foo set from storage ceevyte:narrativa actions[0]
    execute if data storage ceevyte:narrativa foo unless data storage ceevyte:narrativa {foo: ""} run function username:example/narrativa/run_action with storage ceevyte:narrativa
    function username:example/narrativa/run_action:
        $$(foo)

    data remove storage ceevyte:narrativa foo

    execute if data storage ceevyte:narrativa autodub:
        scoreboard players remove /dialog/index ceevyte.narrativa.g 1
        execute store result storage ceevyte:narrativa foo int 1 run scoreboard players get /dialog/index ceevyte.narrativa.g
        scoreboard players add /dialog/index ceevyte.narrativa.g 1
        execute store result storage ceevyte:narrativa bar int 1 run scoreboard players get /dialog/index ceevyte.narrativa.g
        scoreboard players add /dialog/index ceevyte.narrativa.g 1
        execute store result storage ceevyte:narrativa baz int 1 run scoreboard players get /dialog/index ceevyte.narrativa.g
        scoreboard players remove /dialog/index ceevyte.narrativa.g 1

        function username:example/narrativa/autodub with storage ceevyte:narrativa
        function username:example/narrativa/autodub:
            $stopsound @s voice $(autodub)$(foo)
            $playsound $(autodub)$(bar) voice @s ~ ~ ~ 2147483647 1 1
            $stopsound @s voice $(autodub)$(baz)

    data remove storage ceevyte:narrativa foo
    data remove storage ceevyte:narrativa bar
    data remove storage ceevyte:narrativa baz
