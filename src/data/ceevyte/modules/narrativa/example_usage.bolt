import ../narrativa as Narrativa

## Tags

append function_tag minecraft:load {
    "values": [
        "ceevyte:narrativa/main/load"
    ]
}

append function_tag ceevyte:narrativa/show {
    "values": [
        "ceevyte:narrativa/main/show"
    ]
}

append function_tag ceevyte:narrativa/start {
    "values": [
        "ceevyte:narrativa/main/start"
    ]
}

append function_tag ceevyte:narrativa/end {
    "values": [
        "ceevyte:narrativa/main/end"
    ]
}


## General

function ceevyte:narrativa/main/load:
    scoreboard objectives add ceevyte.narrativa.index.e dummy {"text": "Dialogue Index", "color": "gold"}

    scoreboard objectives add ceevyte.narrativa.sneak.e dummy {"text": "Sneak Toggle", "color": "gold"}
    scoreboard objectives add ceevyte.narrativa.sprint.e dummy {"text": "Sprint Toggle", "color": "gold"}
    function ceevyte:narrativa/main/tick

function ceevyte:narrativa/main/tick:
    schedule function ceevyte:narrativa/main/tick 1t replace
    execute as @a[tag=!ceevyte.narrativa.forbidden] at @s:
        execute unless predicate ceevyte:narrativa/sprint:
            execute if score @s ceevyte.narrativa.sprint.e matches 0:
                function ceevyte:narrativa/_/advance
            scoreboard players reset @s ceevyte.narrativa.sprint.e

        execute unless predicate ceevyte:narrativa/sneak if score @s ceevyte.narrativa.sneak.e matches 0:
            scoreboard players reset @s ceevyte.narrativa.sneak.e
            function ceevyte:narrativa/_/rewind

        execute if predicate ceevyte:narrativa/sprint:
            execute unless score @s ceevyte.narrativa.sprint.e matches -1..0 run scoreboard players set @s ceevyte.narrativa.sprint.e 0
            execute if predicate ceevyte:narrativa/sneak:
                scoreboard players set @s ceevyte.narrativa.sneak.e 0
                scoreboard players set @s ceevyte.narrativa.sprint.e -1

function ceevyte:narrativa/main/start:
    bossbar set ceevyte:narrativa/header players @a
    bossbar set ceevyte:narrativa/line1 players @a
    bossbar set ceevyte:narrativa/line2 players @a
    bossbar set ceevyte:narrativa/line3 players @a

function ceevyte:narrativa/main/end:
    bossbar set ceevyte:narrativa/header players 0
    bossbar set ceevyte:narrativa/line1 players 0
    bossbar set ceevyte:narrativa/line2 players 0
    bossbar set ceevyte:narrativa/line3 players 0


## Display

function ceevyte:narrativa/main/show:
    bossbar set ceevyte:narrativa/line1 name {"nbt": "context.lines[0][0]", "storage": "ceevyte:narrativa","interpret":true}
    bossbar set ceevyte:narrativa/line2 name {"nbt": "context.lines[0][1]", "storage": "ceevyte:narrativa","interpret":true}
    bossbar set ceevyte:narrativa/line3 name {"nbt": "context.lines[0][2]", "storage": "ceevyte:narrativa","interpret":true}

    execute:
        data modify storage ceevyte:narrativa context.foo set from storage ceevyte:narrativa context.lines[0][2]
        execute if data storage ceevyte:narrativa context.foo unless data storage ceevyte:narrativa {context:{foo: ""}} run return:
            data modify storage ceevyte:narrativa context.bar set value "\uE002"

        data modify storage ceevyte:narrativa context.foo set from storage ceevyte:narrativa context.lines[0][1]
        execute if data storage ceevyte:narrativa context.foo unless data storage ceevyte:narrativa {context:{foo: ""}} run return:
            data modify storage ceevyte:narrativa context.bar set value "\uE001"

        data modify storage ceevyte:narrativa context.foo set from storage ceevyte:narrativa context.lines[0][0]
        execute if data storage ceevyte:narrativa context.foo unless data storage ceevyte:narrativa {context:{foo: ""}}:
            data modify storage ceevyte:narrativa context.bar set value "\uE000"

    bossbar set ceevyte:narrativa/header name {"nbt": "context.bar", "storage": "ceevyte:narrativa", "font":"ceevyte:narrativa/header", "shadow_color":0}
    data remove storage ceevyte:narrativa context.bar

    data modify storage ceevyte:narrativa context.foo set from storage ceevyte:narrativa context.actions[0]
    execute if data storage ceevyte:narrativa context.foo unless data storage ceevyte:narrativa {context:{foo: ""}} run function ceevyte:narrativa/run_action with storage ceevyte:narrativa context
    function ceevyte:narrativa/run_action:
        $$(foo)

    data remove storage ceevyte:narrativa context.foo

    execute if data storage ceevyte:narrativa context.autodub:
        scoreboard players remove @s ceevyte.narrativa.index.e 1
        execute store result storage ceevyte:narrativa context.foo int 1 run scoreboard players get @s ceevyte.narrativa.index.e
        scoreboard players add @s ceevyte.narrativa.index.e 1
        execute store result storage ceevyte:narrativa context.bar int 1 run scoreboard players get @s ceevyte.narrativa.index.e
        scoreboard players add @s ceevyte.narrativa.index.e 1
        execute store result storage ceevyte:narrativa context.baz int 1 run scoreboard players get @s ceevyte.narrativa.index.e
        scoreboard players remove @s ceevyte.narrativa.index.e 1

        function ceevyte:narrativa/autodub with storage ceevyte:narrativa context
        function ceevyte:narrativa/autodub:
            $stopsound @s voice $(autodub)$(foo)
            $playsound $(autodub)$(bar) voice @s ~ ~ ~ 2147483647 1 1
            $stopsound @s voice $(autodub)$(baz)

    data remove storage ceevyte:narrativa context.foo
    data remove storage ceevyte:narrativa context.bar
    data remove storage ceevyte:narrativa context.baz

function ceevyte:narrativa/dialogue/example:
    Narrativa.new_dialogue(
        lines=[
            [
                'Alex: "You don\'t look like you\'re from around here."'
            ],
            [
                'Steve: "I came here from Newton."'
            ],
            [
                'Alex: "Newton, eh?',
                'I heard there\'s trouble brewing down there."'
            ],
            [
                'Steve: "Did I say Newton?',
                'I\'m actually from Springville."'
            ],
            [
                'Alex: "Oh really?',
                'Then you must know Mr. Bowler."'
            ],
            [
                'Steve: "Who?"'
            ],
            [
                'Alex: "Don\'t you worry about it.',
                'Say, do you have something to eat?'
            ],
            [
                'I\'m starving."'
            ]
        ],
        actions=[
            "",
            "say Newton is a city, btw.",
            "",
            "",
            "",
            "",
            "",
            ""
        ],
        autodub="ceevyte:dialogue.narrativa.example."
    )
