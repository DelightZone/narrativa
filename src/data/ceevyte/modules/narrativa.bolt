## General

function ceevyte:narrativa/load:
    scoreboard objectives add ceevyte.narrativa.g trigger {"text": "Narrativa Globals", "color": "gold"}


## Dialog navigation

function ceevyte:narrativa/dialog/advance:
    execute unless data storage ceevyte:narrativa lines[0] run return fail
    scoreboard players add /dialog/index ceevyte.narrativa.g 1

    data modify storage ceevyte:narrativa _lines prepend from storage ceevyte:narrativa lines[0]
    execute unless data storage ceevyte:narrativa lines[1]:
        function ceevyte:narrativa/dialog/end
    data remove storage ceevyte:narrativa lines[0]

    data modify storage ceevyte:narrativa _actions prepend from storage ceevyte:narrativa actions[0]
    data remove storage ceevyte:narrativa actions[0]

    function #ceevyte:narrativa/show

function ceevyte:narrativa/dialog/rewind:
    execute unless data storage ceevyte:narrativa lines[0] run return fail

    scoreboard players remove /dialog/index ceevyte.narrativa.g 1
    data modify storage ceevyte:narrativa lines prepend from storage ceevyte:narrativa _lines[0]
    execute unless data storage ceevyte:narrativa _lines[0]:
        function ceevyte:narrativa/dialog/end
    data remove storage ceevyte:narrativa _lines[0]

    data modify storage ceevyte:narrativa actions prepend from storage ceevyte:narrativa _actions[0]
    data remove storage ceevyte:narrativa _actions[0]

    function #ceevyte:narrativa/show

function ceevyte:narrativa/dialog/end:
    scoreboard players reset /dialog/index ceevyte.narrativa.g

    data remove storage ceevyte:narrativa foo
    data remove storage ceevyte:narrativa bar

    data remove storage ceevyte:narrativa lines
    data remove storage ceevyte:narrativa _lines
    data remove storage ceevyte:narrativa actions
    data remove storage ceevyte:narrativa _actions

    data remove storage ceevyte:narrativa autodub

    function #ceevyte:narrativa/end

function ceevyte:narrativa/dialog/start:
    function #ceevyte:narrativa/end
    function #ceevyte:narrativa/start


## Choice system

function ceevyte:narrativa/choice/pick:
    execute store result storage ceevyte:narrativa bar int 1 run scoreboard players get /choice/index ceevyte.narrativa.g
    function ceevyte:narrativa/choice/store with storage ceevyte:narrativa
    function ceevyte:narrativa/choice/store:
        $data modify storage ceevyte:narrativa foo set from storage ceevyte:narrativa options[$(bar)]
    
    execute if data storage ceevyte:narrativa foo unless data storage ceevyte:narrativa {foo:""} run function ceevyte:narrativa/choice/resolve
    data remove storage ceevyte:narrativa foo
    data remove storage ceevyte:narrativa bar

function ceevyte:narrativa/choice/resolve:
    function ceevyte:narrativa/choice/run with storage ceevyte:narrativa
    function ceevyte:narrativa/choice/run:
        $$(foo)
    
    scoreboard players reset /choice/index ceevyte.narrativa.g

## API

def new_dialog(
    lines=[],
    actions=[],
    autodub=""
):
    function ceevyte:narrativa/dialog/start
    scoreboard players set /dialog/index ceevyte.narrativa.g 0

    data remove storage ceevyte:narrativa _lines
    data modify storage ceevyte:narrativa "lines" set value lines
    data modify storage ceevyte:narrativa "lines" prepend value ""

    data remove storage ceevyte:narrativa _actions
    data modify storage ceevyte:narrativa "actions" set value actions
    data modify storage ceevyte:narrativa "actions" prepend value ""

    if autodub:
        data modify storage ceevyte:narrativa "autodub" set value autodub

    function ceevyte:narrativa/dialog/advance
    data remove storage ceevyte:narrativa _lines[-1]
    data remove storage ceevyte:narrativa _actions[-1]

class new_choice:
    def __init__(
        self,
        objective="none"
    ):
        self.objective = objective
        self.choices = [""]

    def option(
        self,
        option=""
    ):
        self._append_option(option)
        return f"trigger {self.objective} set {len(self.choices) - 1}"

    def _append_option(
        self,
        option=""
    ):
        self.choices.append(option)

    def flush(self):
        data modify storage ceevyte:narrativa options set value self.choices
        self.choices = [""]